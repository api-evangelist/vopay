                        "type": "text/plain"
                      },
                      "key": "Key",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Hashed signature for the request",
                        "type": "text/plain"
                      },
                      "key": "Signature",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) The unique ID of the original transaction to resubmit",
                        "type": "text/plain"
