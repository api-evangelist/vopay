        {
          "id": "1f9baf58-a508-4576-8461-9ea2ec918e6f",
          "name": "Set auto-unblock threshold",
          "request": {
            "name": "Set auto-unblock threshold",
            "description": {
              "content": "Sets the AutoUnblockThreshold on a sub-account's blocked account settings. When the sub-account's balance reaches this threshold, it will be automatically unblocked. Pass an empty value to clear the threshold. Requires the ManageBlockedAccounts permission.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "account",
                "blocked-account",
                "set-autounblock-threshold"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "AccountID",
                  "value": "<string>",
                  "description": "(Required) Your account ID"
                },
