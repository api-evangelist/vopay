                  "description": "(Required) Hashed signature for the request"
                },
                {
                  "disabled": false,
                  "key": "VopayAccountID",
                  "value": "<string>",
                  "description": "(Required) The VoPay sub-account ID to configure. Must belong to the authenticated account."
