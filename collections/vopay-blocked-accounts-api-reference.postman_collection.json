          "name": "Block account(s)",
          "request": {
            "name": "Block account(s)",
            "description": {
              "content": "Blocks one or all sub-accounts under the authenticated secured account. Optionally transfers any available funds out of the blocked account(s). Requires the ManageBlockedAccounts permission.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "account",
                "blocked-account",
                "block"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
