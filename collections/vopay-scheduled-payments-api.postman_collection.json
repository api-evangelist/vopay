                {
                  "description": "(Required) The currency code (e.g., USD, CAD)",
                  "key": "Currency",
                  "value": "<string>"
                },
                {
                  "description": "(Required) The type of payment (e.g., debit, credit)",
                  "key": "PaymentType",
